# C2inaBox configuration
# Copy to .env and customise:  cp .env.example .env

# Path to cloned AdaptixC2 source (for building)
ADAPTIX_SRC=./../AdaptixC2

# Elasticsearch
ES_PORT=9200
ES_HEAP=1g
ES_MEM_LIMIT=3G
ELASTIC_PASSWORD=c2inabox-lab

# Kibana
KIBANA_PORT=5601
KIBANA_SYSTEM_PASSWORD=c2inabox-lab

# Fleet (generate token: POST _security/service/elastic/fleet-server/credential/token)
FLEET_PORT=8220
# FLEET_SERVICE_TOKEN=<your-service-token>

# Payloads (used by setup-listener.ps1 -GeneratePayload)
# PAYLOAD_DIR=C:\Tools\Payloads
